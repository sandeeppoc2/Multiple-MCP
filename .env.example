# Copy to .env and fill in. Everything here is optional but each server
# degrades or stays unauthenticated without its token.

# --- GitHub MCP (remote: https://api.githubcopilot.com/mcp/) -----------------
# Classic PAT with the scopes for the tools you enable.
#   repo, read:org, read:user, read:packages, workflow  (add write scopes only if needed)
# Create at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: restrict which toolsets the remote server exposes.
# Defaults to context,repos,issues,pull_requests,users. Set for less context bloat.
# GITHUB_TOOLSETS=repos,issues,pull_requests

# --- Snyk MCP (local, runs the Snyk CLI) -------------------------------------
# Either authenticate interactively once with `npx snyk auth`, or set a token here.
# Create at https://app.snyk.io/account  (Personal Access Token)
SNYK_TOKEN=

# Optional: select a Snyk organization, or point at a regional / on-prem API host.
# SNYK_CFG_ORG=
# SNYK_API=

# --- Figma MCP ---------------------------------------------------------------
# The official remote server (https://mcp.figma.com/mcp) authenticates with OAuth
# from inside your MCP client. No token goes in this file.
#
# Only needed if you swap to the Framelink local server (figma-developer-mcp):
# FIGMA_API_KEY=
